@model task_management_system.Models.AddTask

@{
    ViewData["Title"] = $"{Model.TaskTitle} - Task Details";
    Layout = "_DashboardLayout";
}

<link rel="stylesheet" href="~/css/webpages-css/task-dashboard.css" asp-append-version="true" />

<!-- Task Dashboard Header -->
<div class="dashboard-header">
    <div class="header-left">
        <h1><i class="fas fa-tasks"></i> @Model.TaskTitle</h1>
        <span class="task-status-badge @Model.TaskStatus.ToString().ToLower()">@Model.TaskStatus</span>
    </div>
    <div class="header-right">
        <span class="task-priority-badge @Model.Priority.ToString().ToLower()">@Model.Priority Priority</span>
        @if (Model.DueDate.HasValue)
        {
            var localDueDate = Model.DueDate.Value.ToLocalTime();
            <span class="task-due-badge">
                <i class="fas fa-clock"></i> Due: @localDueDate.ToString("MMM dd, yyyy 'at' hh:mm tt")
            </span>
        }
    </div>
</div>

<!-- Main Content -->
<div class="task-dashboard-container">
    <!-- Left Side - Task Details & Comments -->
    <div class="task-main-content">
        <!-- Task Information Card -->
        <div class="task-info-card">
            <div class="card-header">
                <h3><i class="fas fa-info-circle"></i> Task Information</h3>
            </div>
            <div class="card-content">
                <div class="info-row">
                    <label>Name:</label>
                    <div class="info-value">@Model.TaskTitle</div>
                </div>
                <div class="info-row">
                    <label>Description:</label>
                    <div class="info-value">@(Model.Description ?? "No description provided")</div>
                </div>
                <div class="info-row">
                    <label>Project:</label>
                    <div class="info-value">@(Model.ProjectId ?? "No project assigned")</div>
                </div>
                <div class="info-row">
                    <label>Priority:</label>
                    <div class="info-value">
                        <span class="priority-badge @Model.Priority.ToString().ToLower()">@Model.Priority</span>
                    </div>
                </div>
                <div class="info-row">
                    <label>Status:</label>
                    <div class="info-value">
                        <span class="status-badge @Model.TaskStatus.ToString().ToLower()">@Model.TaskStatus</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.AttachmentFileUrl))
                {
                    <div class="info-row">
                        <label>Attachment:</label>
                        <div class="info-value">
                            <div class="task-attachment-display">
                                <i class="fas fa-paperclip"></i>
                                <a href="@Model.AttachmentFileUrl" target="_blank" class="attachment-link">
                                    @Model.AttachmentFileName
                                </a>
                                @if (Model.AttachmentFileSize.HasValue)
                                {
                                    <span class="file-size">(@((Model.AttachmentFileSize.Value / 1024.0 / 1024.0).ToString("F2")) MB)</span>
                                }
                                <a href="@Model.AttachmentFileUrl" download="@Model.AttachmentFileName" class="btn-download" title="Download attachment">
                                    <i class="fas fa-download"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Comments Section -->
        <div class="comments-card mb-4">
            <div class="card-header">
                <h3><i class="fas fa-comments"></i> Comments</h3>
                <span class="comment-count" id="commentCount">0</span>
            </div>
            <div class="card-content">
                <!-- Comments List -->
                <div class="comments-list" id="commentsList">
                    <!-- Comments will be loaded here -->
                    <div class="empty-comments">
                        <i class="fas fa-comment-slash"></i>
                        <p>No comments yet. Be the first to add one!</p>
                    </div>
                </div>

                <!-- Add Comment Form -->
                <div class="add-comment-form">
                    <div class="form-group">
                        <textarea id="commentText" class="form-control" rows="3" 
                                  placeholder="Write a comment..."></textarea>
                    </div>
                    <div class="form-actions">
                        <input type="file" id="commentFileInput" style="display: none;" onchange="handleCommentFileSelect(event)">
                        <button type="button" class="btn btn-outline btn-icon" onclick="document.getElementById('commentFileInput').click()" title="Attach file">
                            <i class="fas fa-paperclip"></i>
                        </button>
                        <button type="button" class="btn btn-primary" onclick="addComment()">
                            <i class="fas fa-paper-plane"></i>
                            Post Comment
                        </button>
                    </div>
                    <div id="commentFilePreview" class="comment-file-preview" style="display: none;">
                        <div class="file-info">
                            <i class="fas fa-file" id="commentFileIcon"></i>
                            <span class="file-name" id="commentFileName"></span>
                            <button type="button" class="remove-file" onclick="removeCommentFile()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side - Add Work Section -->
    <div class="task-sidebar mb-4">
        @if (ViewBag.IsTaskOwner != true)
        {
            <!-- Show work submission form for assigned members -->
            <div class="work-card">
                <div class="card-header">
                    <h3><i class="fas fa-briefcase"></i> Submit Work</h3>
                </div>
                <div class="card-content">
                    <form id="addWorkForm">
                        @if (Model.TaskStatus == task_management_system.Models.TaskStatus.Pending)
                        {
                            <div class="alert alert-info mb-3" style="background: #FFF3E0; color: #E65100; border: 1px solid #FFB74D;">
                                <i class="fas fa-info-circle"></i>
                                <div style="margin-left: 0.5rem;">
                                    <strong>Revision Requested</strong>
                                    <p style="margin: 0.25rem 0 0 0; font-size: 0.9rem;">The team lead has returned this task for revision. Please resubmit your work.</p>
                                </div>
                            </div>
                        }
                        <div class="form-group">
                            <label for="workDescription">Work Description</label>
                            <textarea id="workDescription" class="form-control" rows="4" 
                                      placeholder="Describe the work done..."></textarea>
                        </div>
                        <div class="form-group">
                            <label for="workFile">
                                <i class="fas fa-paperclip"></i> Attach File
                            </label>
                            <div class="file-upload-wrapper">
                                <input type="file" id="workFile" class="file-input" 
                                       accept="*/*" onchange="handleFileSelect(event)">
                                <label for="workFile" class="file-upload-label">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <span id="fileLabel">Choose a file or drag & drop</span>
                                </label>
                                <div id="filePreview" class="file-preview" style="display: none;">
                                    <div class="file-info">
                                        <i class="fas fa-file"></i>
                                        <div class="file-details">
                                            <span class="file-name" id="fileName"></span>
                                            <span class="file-size" id="fileSize"></span>
                                        </div>
                                        <button type="button" class="remove-file" onclick="removeFile()">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-primary btn-block" onclick="submitWork()">
                            <i class="fas fa-check"></i>
                            Submit Work
                        </button>
                    </form>

                    <!-- Work Log -->
                    <div class="work-log">
                        <h4><i class="fas fa-history"></i> My Submissions</h4>
                        <div id="workLogList" class="work-log-list">
                            <!-- Work log items will be loaded here -->
                            <div class="empty-work-log">
                                <i class="fas fa-clipboard-list"></i>
                                <p>No work submitted yet</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Show work log review for task owner -->
            <div class="work-card">
                <div class="card-header">
                    <h3><i class="fas fa-clipboard-check"></i> Work Submissions</h3>
                </div>
                <div class="card-content">
                    <!-- Work Log for Review -->
                    <div class="work-log">
                        <h4><i class="fas fa-history"></i> Team Submissions</h4>
                        <div id="workLogList" class="work-log-list">
                            <!-- Work log items will be loaded here -->
                            <div class="empty-work-log">
                                <i class="fas fa-clipboard-list"></i>
                                <p>No work submitted yet</p>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i>
                        <div style="margin-left: 0.5rem;">
                            <strong>Review Instructions:</strong>
                            <ul style="margin: 0.5rem 0 0 0; padding-left: 1.5rem; font-size: 0.9rem;">
                                <li>Check the task checkbox to mark as <strong>Completed</strong> after reviewing work</li>
                                <li>Uncheck the checkbox to return task to <strong>Pending</strong> if work needs revision</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.taskData = {
            taskId: '@Model.TaskId',
            addCommentUrl: '@Url.Action("AddComment", "Task")',
            getCommentsUrl: '@Url.Action("GetComments", "Task")',
            addWorkUrl: '@Url.Action("AddWork", "Task")',
            getWorkUrl: '@Url.Action("GetWork", "Task")'
        };
    </script>
    <script src="~/js/webpages-js/task-dashboard.js" asp-append-version="true"></script>
}
