@model List<task_management_system.Models.AddTask>

@{
    ViewData["Title"] = "Tasks";
    Layout = "_DashboardLayout";
}

<link rel="stylesheet" href="~/css/webpages-css/task-page.css" asp-append-version="true" />

<!-- Tasks Page Content -->
<div class="page-header">
    <div class="header-left">
        <h1><i class="fas fa-tasks"></i> Tasks</h1>
        <p>Manage your tasks and stay organized</p>
    </div>
    <div class="header-right">
        <button class="btn btn-primary" id="newTaskBtn">
            <i class="fas fa-plus"></i> New Task
        </button>
    </div>
</div>

<div class="tasks-filters">
    <button class="filter-btn active" data-filter="all">All Tasks</button>
    <div class="status-filter-container" id="statusFiltersContainer">
        <!-- Status filters will be dynamically populated -->
    </div>
    <div class="status-actions-group" style="margin-left: auto;">
        <button class="btn" id="quickAddStatusBtn">
            <i class="fas fa-plus"></i>
        </button>

        <div class="dropdown" style="position: relative; display: inline-block;">
            <button class="btn" id="moreActionsBtn">
                <i class="fas fa-ellipsis-h"></i>
            </button>

            <div class="dropdown-menu-task" id="statusDropdownMenu" style="display: none;">
                <a class="dropdown-item" href="#" id="manageStatusLink">
                    <i class="fas fa-cog"></i> Manage Status Labels
                </a>
                <a class="dropdown-item" href="#" id="markCompleteBtn">
                    <i class="fas fa-check-double"></i> Mark all as Complete
                </a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="#" id="resetStatusBtn">
                    <i class="fas fa-redo"></i> Reset to Default
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Status Manager Panel (hidden by default) -->
<div id="quickAddPanel" class="quick-add-panel" style="display: none;">
    <div class="quick-add-content">
        <div class="quick-add-header">
            <h5 class="mb-0">How do you track work?</h5>
            <button class="btn-close-panel" id="closeQuickAdd">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="quick-add-body">
            <p class="status-subtitle">As you complete work, it moves through these statuses.</p>
            
            <!-- Status List -->
            <div class="status-list" id="statusList">
                <!-- Status items will be populated here -->
            </div>
            
            <!-- Add Status Button -->
            <button class="btn-add-status" id="addStatusBtn">
                Add status
            </button>
            
            <!-- Finish Button -->
            <button class="btn-finish" id="finishStatusBtn">
                Finish
            </button>
        </div>
    </div>
</div>

<div class="tasks-container" id="tasksContainer">
  @if (Model?.Any() == true)
    {
        var currentUserId = ViewBag.UserId as string;
        
        @foreach (var task in Model)
        {
            var isOwner = task.UserId == currentUserId;
            
            // Determine status color based on TaskStatus enum if no custom label color
            string? statusColor = task.StatusLabelColor;
            string statusDisplay = task.StatusLabelName ?? task.TaskStatus.ToString();
            
            if (string.IsNullOrEmpty(statusColor))
            {
                switch (task.TaskStatus)
                {
                    case task_management_system.Models.TaskStatus.Pending:
                        statusColor = "#9E9E9E"; // Gray
                        statusDisplay = "To Do";
                        break;
                    case task_management_system.Models.TaskStatus.InProgress:
                        statusColor = "#2196F3"; // Blue
                        statusDisplay = "In Progress";
                        break;
                    case task_management_system.Models.TaskStatus.Review:
                        statusColor = "#FDD835"; // Yellow
                        statusDisplay = "Review";
                        break;
                    case task_management_system.Models.TaskStatus.Completed:
                        statusColor = "#28a745"; // Green
                        statusDisplay = "Completed";
                        break;
                    default:
                        statusColor = "#6c757d";
                        break;
                }
            }
            
            // Use TaskStatus enum string value for data-status (Pending, InProgress, Review, Completed)
            var dataStatus = task.StatusLabelId ?? task.TaskStatus.ToString();
            
            <div class="task-item" data-status="@dataStatus" data-id="@task.TaskId" onclick="window.location.href='@Url.Action("Dashboard", "Task", new { id = task.TaskId })'" style="cursor: pointer;">
                @if (isOwner)
                {
                    <div class="task-status-badge" onclick="event.stopPropagation();" style="background-color: @statusColor;">
                        <select class="status-dropdown" data-task-id="@task.TaskId" onchange="updateTaskStatus('@task.TaskId', this.value)" onclick="event.stopPropagation();">
                            <!-- Options will be populated dynamically -->
                        </select>
                        <span class="status-display">@statusDisplay</span>
                    </div>
                }
                else
                {
                    <div class="task-status-badge-readonly" style="background-color: @statusColor;">
                        @statusDisplay
                    </div>
                }
                <div class="task-content">
                    <h4>@task.TaskTitle</h4>
                    <p class="task-description">@task.Description</p>
                    <div class="task-meta">
                        @if (!string.IsNullOrEmpty(task.ProjectId))
                        {
                            <span class="task-project">@task.ProjectId</span>
                        }
                        @if (!string.IsNullOrEmpty(task.AssignedUserName))
                        {
                            <span class="task-assigned">
                                <i class="fas fa-user"></i> @task.AssignedUserName
                            </span>
                        }
                        @if (task.DueDate.HasValue)
                        {
                            var localDueDate = task.DueDate.Value.ToLocalTime();
                            <span class="task-due">
                                 Due: @localDueDate.ToString("MMM dd, yyyy 'at' hh:mm tt")
                            </span>
                        }
                        <span class="task-priority @task.Priority.ToString().ToLower()">@task.Priority Priority</span>
                    </div>
                </div>
                <div class="task-actions" onclick="event.stopPropagation();">
                    @if (isOwner)
                    {
                        <button class="btn-icon assign" onclick="assignTask('@task.TaskId')" title="Assign to member"></button>
                        <button class="btn-icon edit" onclick="editTask('@task.TaskId')"><i class="fas fa-edit"></i></button>
                        <button class="btn-icon delete" onclick="deleteTask('@task.TaskId')"><i class="fas fa-trash"></i></button>
                    }
                    else
                    {
                        <span class="task-member-badge" title="You are assigned to this task">
                            <i class="fas fa-user-check"></i> Assigned to You
                        </span>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-tasks empty-icon"></i>
            <h3>No tasks yet</h3>
            <p>Create your first task to get started with managing your work.</p>
        </div>
    }
</div>

<!-- New Task Modal - Wide Version -->
<div class="yeloe-modal-overlay" id="taskModalOverlay">
    <div class="yeloe-modal" id="taskModal">
        <form id="createTaskForm">
            <div class="yeloe-modal-header">
                <h4 class="yeloe-modal-title">Create New Task</h4>
                <p class="yeloe-modal-subtitle">Add a new task to your workflow</p>
            </div>

            <div class="yeloe-modal-body">
                <div class="form-group full-width">
                    <label for="taskTitle" class="form-label">Task Title *</label>
                    <input type="text" id="taskTitle" name="Title" class="form-control"
                           placeholder="Enter task title..." required>
                    <span class="error-message" id="titleError"></span>
                </div>

                <div class="form-group full-width">
                    <label for="taskDescription" class="form-label">Description</label>
                    <textarea id="taskDescription" name="Description" class="form-control"
                              rows="3" placeholder="Describe your task..."></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="taskProject" class="form-label">Project</label>
                        <select id="taskProject" name="Project" class="form-control">
                            <option value="">-- Select or Create Project --</option>
                            <option value="Project 1" selected>Project 1</option>
                            @if (ViewBag.Projects != null)
                            {
                                @foreach (var project in ViewBag.Projects)
                                {
                                    <option value="@project.ProjectName">@project.ProjectName</option>
                                }
                            }
                            <option value="__new__">+ Create New Project...</option>
                        </select>
                        <input type="text" id="taskProjectCustom" class="form-control" 
                               placeholder="Enter new project name" style="display: none; margin-top: 10px;">
                    </div>
                    <div class="form-group">
                        <label for="taskDueDate" class="form-label">Due Date *</label>
                        <input type="date" id="taskDueDate" name="DueDate" class="form-control">
                        
                        <!-- Time input section (hidden by default) -->
                        <div id="timeInputSection" style="display: none; margin-top: 15px;">
                            <label class="form-label" style="font-size: 0.9rem; margin-bottom: 8px;">
                                 Set Time (Optional)
                            </label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <input type="number" id="taskHour" min="1" max="12" placeholder="HH" 
                                       class="form-control" style="width: 70px; text-align: center;">
                                <span style="font-weight: bold; font-size: 1.2rem;">:</span>
                                <input type="number" id="taskMinute" min="0" max="59" placeholder="MM" 
                                       class="form-control" style="width: 70px; text-align: center;">
                                <select id="taskPeriod" class="form-control" style="width: 80px;">
                                    <option value="AM">AM</option>
                                    <option value="PM" selected>PM</option>
                                </select>
                            </div>
                            <small class="form-text text-muted" style="margin-top: 8px;">
                                You'll be notified 12 hours and 1 hour before deadline
                            </small>
                        </div>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label for="taskAssignedTo" class="form-label"> Assign To (Optional)
                    </label>
                    <select id="taskAssignedTo" name="AssignedTo" class="form-control">
                        <option value="">-- Not Assigned --</option>
                        <!-- Will be populated dynamically based on selected project -->
                    </select>
                    <small class="form-text text-muted">
                        Select a project first to see available members
                    </small>
                </div>

                <div class="form-group full-width">
                    <label for="taskPriority" class="form-label">Priority</label>
                    <select id="taskPriority" name="Priority" class="form-control">
                        <option value="Low">Low Priority</option>
                        <option value="Medium" selected>Medium Priority</option>
                        <option value="High">High Priority</option>
                    </select>
                </div>

                <div class="form-group full-width">
                    <label for="taskAttachment" class="form-label">
                        <i class="fas fa-paperclip"></i> Attachment (Optional)
                    </label>
                    <div class="file-upload-wrapper">
                        <input type="file" id="taskAttachment" name="Attachment" class="file-input" accept="*/*">
                        <label for="taskAttachment" class="file-upload-label">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <span id="fileNameDisplay">Choose a file or drag it here</span>
                        </label>
                        <button type="button" class="file-remove-btn" id="removeFileBtn" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <small class="form-text text-muted">
                        Maximum file size: 10MB. Supported formats: PDF, DOC, DOCX, XLS, XLSX, PNG, JPG, etc.
                    </small>
                </div>
            </div>

            <div class="yeloe-modal-footer">
                <button type="button" class="task-modal-btn task-modal-btn-cancel" id="cancelTaskBtn">
                    <i class="fas fa-times"></i>
                    <span>Cancel</span>
                </button>
                <button type="submit" class="task-modal-btn task-modal-btn-submit" id="createTaskBtn">
                    <i class="fas fa-plus"></i>
                    <span>Create Task</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Set task URLs for AJAX calls
        window.taskUrls = {
            createUrl: '@Url.Action("Create", "Task")',
            updateUrl: '@Url.Action("Update", "Task")',
            getTaskUrl: '@Url.Action("GetTask", "Task")',
            completeUrl: '@Url.Action("Complete", "Task")',
            deleteUrl: '@Url.Action("Delete", "Task")',
            getProjectMembersUrl: '@Url.Action("GetProjectMembers", "Projects")',
            updateStatusUrl: '@Url.Action("UpdateStatus", "Task")'
        };

        window.statusUrls = {
            getLabelsUrl: '/api/TaskStatus/labels',
            createLabelUrl: '/api/TaskStatus/labels',
            updateLabelUrl: '/api/TaskStatus/labels',
            deleteLabelUrl: '/api/TaskStatus/labels',
            initializeUrl: '/api/TaskStatus/labels/initialize'
        };
    </script>
    <script src="~/js/webpages-js/task-index.js" asp-append-version="true"></script>
    <script src="~/js/webpages-js/task-page.js" asp-append-version="true"></script>
    <script src="~/js/webpages-js/task-status-clean.js" asp-append-version="true"></script>
}