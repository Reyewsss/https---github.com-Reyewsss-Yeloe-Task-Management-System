                            @if (!string.IsNullOrEmpty(task.AttachmentFileUrl))
                            {
                                <div class="kanban-attachment-indicator">
                                    <i class="fas fa-paperclip"></i>
                                    <span>@task.AttachmentFileName</span>
                                </div>
                            }
                            <div class="kanban-card-footer">
                                <span class="priority-badge @task.Priority.ToString().ToLower()">@task.Priority</span>
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="due-date"><i class="fas fa-calendar"></i> @task.DueDate.Value.ToString("MMM dd")</span>
                                }
                                @if (!canInteract)
                                {
                                    <span class="view-only-badge">
                                        <i class="fas fa-eye"></i> View Only
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(task.AssignedUserName))
                                {
                                    <span class="assigned-badge">
                                        <i class="fas fa-user"></i> @task.AssignedUserName
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        
        <div class="kanban-column">
            <div class="kanban-header review">
                <h3><i class="fas fa-eye"></i> Review</h3>
                <span class="task-count">@(tasks?.Count(t => t.TaskStatus == task_management_system.Models.TaskStatus.Review) ?? 0)</span>
            </div>
            <div class="kanban-tasks" data-status="Review">
                @if (tasks != null)
                {
                    @foreach (var task in tasks.Where(t => t.TaskStatus == task_management_system.Models.TaskStatus.Review))
                    {
                        // Only project owner can drag and drop
                        var canInteract = isProjectOwner && !string.IsNullOrEmpty(task.TaskId);
                        var cardClass = canInteract ? "kanban-card" : "kanban-card view-only";
                        var draggable = canInteract ? "true" : "false";
                        <div class="@cardClass" data-id="@task.TaskId" data-status="Review" draggable="@draggable" data-can-interact="@canInteract.ToString().ToLower()">
                            <h4>@task.TaskTitle</h4>
                            <p>@task.Description</p>
                            @if (!string.IsNullOrEmpty(task.AttachmentFileUrl))
                            {
                                <div class="kanban-attachment-indicator">
                                    <i class="fas fa-paperclip"></i>
                                    <span>@task.AttachmentFileName</span>
                                </div>
                            }
                            <div class="kanban-card-footer">
                                <span class="priority-badge @task.Priority.ToString().ToLower()">@task.Priority</span>
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="due-date"><i class="fas fa-calendar"></i> @task.DueDate.Value.ToString("MMM dd")</span>
                                }
                                @if (!canInteract)
                                {
                                    <span class="view-only-badge">
                                        <i class="fas fa-eye"></i> View Only
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(task.AssignedUserName))
                                {
                                    <span class="assigned-badge">
                                        <i class="fas fa-user"></i> @task.AssignedUserName
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        
        <div class="kanban-column">
            <div class="kanban-header completed">
                <h3><i class="fas fa-check"></i> Completed</h3>
                <span class="task-count">@(tasks?.Count(t => t.TaskStatus == task_management_system.Models.TaskStatus.Completed) ?? 0)</span>
            </div>
            <div class="kanban-tasks" data-status="Completed">
                @if (tasks != null)
                {
                    @foreach (var task in tasks.Where(t => t.TaskStatus == task_management_system.Models.TaskStatus.Completed))
                    {
                        // Only project owner can drag and drop
                        var canInteract = isProjectOwner && !string.IsNullOrEmpty(task.TaskId);
                        var cardClass = canInteract ? "kanban-card completed" : "kanban-card completed view-only";
                        var draggable = canInteract ? "true" : "false";
                        <div class="@cardClass" data-id="@task.TaskId" data-status="Completed" draggable="@draggable" data-can-interact="@canInteract.ToString().ToLower()">
                            <h4>@task.TaskTitle</h4>
                            <p>@task.Description</p>
                            @if (!string.IsNullOrEmpty(task.AttachmentFileUrl))
                            {
                                <div class="kanban-attachment-indicator">
                                    <i class="fas fa-paperclip"></i>
                                    <span>@task.AttachmentFileName</span>
                                </div>
                            }
                            <div class="kanban-card-footer">
                                <span class="priority-badge @task.Priority.ToString().ToLower()">@task.Priority</span>
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="due-date"><i class="fas fa-calendar"></i> @task.DueDate.Value.ToString("MMM dd")</span>
                                }
                                @if (!canInteract)
                                {
                                    <span class="view-only-badge">
                                        <i class="fas fa-eye"></i> View Only
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(task.AssignedUserName))
                                {
                                    <span class="assigned-badge">
                                        <i class="fas fa-user"></i> @task.AssignedUserName
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="tab-content mb-4" id="tasks-tab">
    <div class="tasks-list-container">
        @if (tasks?.Any() == true)
        {
            @foreach (var task in tasks.OrderByDescending(t => t.CreatedAt))
            {
                <div class="task-list-item @(task.IsCompleted ? "completed" : "")" data-id="@task.TaskId">
                    @if (ViewBag.IsProjectOwner == true)
                    {
                        <div class="task-checkbox">
                            <input type="checkbox" @(task.IsCompleted ? "checked" : "")>
                        </div>
                    }
                    <div class="task-info">
                        <h4>@task.TaskTitle</h4>
                        <p>@task.Description</p>
                        <div class="task-tags">
                            @{
                                var statusDisplay = task.TaskStatus.ToString();
                                var statusClass = task.TaskStatus.ToString().ToLower();
                                
                                switch (task.TaskStatus)
                                {
                                    case task_management_system.Models.TaskStatus.Pending:
                                        statusDisplay = "To Do";
                                        statusClass = "pending";
                                        break;
                                    case task_management_system.Models.TaskStatus.InProgress:
                                        statusDisplay = "In Progress";
                                        statusClass = "inprogress";
                                        break;
                                    case task_management_system.Models.TaskStatus.Review:
                                        statusDisplay = "Review";
                                        statusClass = "review";
                                        break;
                                    case task_management_system.Models.TaskStatus.Completed:
                                        statusDisplay = "Completed";
                                        statusClass = "completed";
                                        break;
                                }
                            }
                            <span class="status-badge @statusClass">@statusDisplay</span>
                            <span class="priority-badge @task.Priority.ToString().ToLower()">@task.Priority</span>
                            @if (task.DueDate.HasValue)
                            {
                                <span class="due-badge"><i class="fas fa-calendar"></i> @task.DueDate.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-tasks empty-icon"></i>
                <h3>No tasks in this project</h3>
                <p>Create tasks and assign them to this project to see them here.</p>
            </div>
        }
    </div>
</div>

<div class="tab-content mb-4" id="gantt-tab">
    <div class="gantt-container">
        <div class="gantt-header">
            <h3><i class="fas fa-chart-bar"></i> Project Timeline</h3>
            <p>Visual representation of project tasks over time</p>
        </div>
        @if (tasks?.Any() == true)
        {
            <div class="gantt-chart" id="ganttChart">
                <div class="gantt-timeline">
                    <div class="gantt-months" id="ganttMonths"></div>
                </div>
                <div class="gantt-tasks" id="ganttTasks">
                    @foreach (var task in tasks.OrderBy(t => t.DueDate ?? DateTime.MaxValue))
                    {
                        if (task.DueDate.HasValue)
                        {
                            <div class="gantt-task-row" data-task-id="@task.TaskId">
                                <div class="gantt-task-info">
                                    <span class="gantt-task-title">@task.TaskTitle</span>
                                    <span class="gantt-task-assignee">
                                        @if (!string.IsNullOrEmpty(task.AssignedUserName))
                                        {
                                            <text><i class="fas fa-user"></i> @task.AssignedUserName</text>
                                        }
                                        else
                                        {
                                            <text><i class="fas fa-user-slash"></i> Unassigned</text>
                                        }
                                    </span>
                                </div>
                                <div class="gantt-task-timeline">
                                    @{
                                        var ganttStatusClass = task.TaskStatus == task_management_system.Models.TaskStatus.InProgress ? "inprogress" : task.TaskStatus.ToString().ToLower();
                                    }
                                    <div class="gantt-task-bar @ganttStatusClass" 
                                         data-start="@task.CreatedAt.ToString("yyyy-MM-dd")"
                                         data-end="@task.DueDate.Value.ToString("yyyy-MM-dd")"
                                         data-status="@task.TaskStatus.ToString()">
                                        <span class="gantt-task-bar-label">
                                            @((task.DueDate.Value - task.CreatedAt).Days + 1) days
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else
        {
            <div class="gantt-placeholder">
                <i class="fas fa-chart-gantt" style="font-size: 3rem; color: #ddd; margin-bottom: 1rem;"></i>
                <p>No tasks with due dates to display</p>
                <small>Create tasks with due dates to see them in the timeline</small>
            </div>
        }
    </div>
</div>

<div class="tab-content mb-4" id="team-tab">
    <div class="team-container">
        <div class="team-header">
            <h3><i class="fas fa-users"></i> Team Members</h3>
            <div class="team-header-actions">
                <button class="btn btn-secondary btn-sm" id="refreshMembersBtn" title="Refresh members list">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
                @if (ViewBag.IsProjectOwner == true)
                {
                    <button class="btn btn-primary btn-sm" id="addMemberBtn">
                        <i class="fas fa-user-plus"></i> Add Member
                    </button>
                }
            </div>
        </div>
        <div class="team-members" id="teamMembersList">
            <!-- Project Owner -->
            <div class="team-member owner-member">
                <div class="member-avatar owner-avatar">
                    @if (!string.IsNullOrEmpty(Model.CreatedByProfilePicture))
                    {
                        <img src="@Model.CreatedByProfilePicture" alt="Owner" class="member-avatar-img" />
                    }
                    else
                    {
                        <i class="fas fa-crown"></i>
                    }
                </div>
                <div class="member-info">
                    <h4>@Model.CreatedByName <span class="owner-badge"><i class="fas fa-crown"></i></span></h4>
                    <p>Project Owner</p>
                </div>
                <span class="member-role owner">Owner</span>
            </div>
            
            <!-- Dynamic Members Container -->
            <div id="dynamicMembersList">
                @if (ViewBag.ProjectMembers != null && ((List<task_management_system.Models.ProjectMember>)ViewBag.ProjectMembers).Any())
                {
                    @foreach (var member in (List<task_management_system.Models.ProjectMember>)ViewBag.ProjectMembers)
                    {
                        <div class="team-member" data-member-id="@member.UserId">
                            <div class="member-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="member-info">
                                <h4>@member.UserName</h4>
                                <p>@member.UserEmail</p>
                                <small class="text-muted">Joined @member.JoinedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                            <div class="member-actions">
                                <span class="member-role @member.Role.ToString().ToLower()">@member.Role</span>
                                @if (ViewBag.IsProjectOwner == true)
                                {
                                    <button class="btn-remove-member" title="Remove member" onclick="removeMember('@member.UserId', '@member.UserName')">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-team-state" id="emptyMembersState">
                        <i class="fas fa-user-plus" style="font-size: 2rem; color: #ddd; margin-bottom: 1rem;"></i>
                        <p>No team members yet</p>
                        <small>Invite team members to collaborate on this project</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Invite Member Modal -->
<div class="modal-overlay" id="inviteMemberModal">
    <div class="modal-container">
        <div class="modal-header">
            <h3><i class="fas fa-user-plus"></i> Invite Team Member</h3>
            <button class="close-btn" id="closeInviteModal">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <form id="inviteMemberForm">
                <div class="form-group">
                    <label for="memberEmail">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>
                    <input type="email" 
                           class="form-control" 
                           id="memberEmail" 
                           name="email" 
                           placeholder="Enter email address" 
                           required>
                    <small class="form-text text-muted">
                        The user must have an account in the system to receive the invitation.
                    </small>
                </div>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    <div>
                        <strong>Viewer Access</strong>
                        <p style="margin: 0; font-size: 0.9rem;">Members will have view-only access and can submit updates but cannot create or edit project content.</p>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelInviteBtn">Cancel</button>
            <button type="button" class="btn btn-primary" id="sendInviteBtn">
                <i class="fas fa-paper-plane"></i> Send Invitation
            </button>
        </div>
    </div>
</div>

<!-- Remove Member Confirmation Modal -->
<div class="modal-overlay" id="removeMemberModal">
    <div class="modal-container modal-sm">
        <div class="modal-header modal-header-danger">
            <h3><i class="fas fa-user-times"></i> Remove Member</h3>
            <button class="close-btn" id="closeRemoveModal">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="confirmation-message">
                <div class="confirmation-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <p>Are you sure you want to remove <strong id="memberNameToRemove"></strong> from this project?</p>
                <p class="text-muted" style="font-size: 0.9rem; margin-top: 0.5rem;">This action cannot be undone. The member will lose access to this project immediately.</p>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelRemoveBtn">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmRemoveBtn">
                <i class="fas fa-trash-alt"></i> Remove Member
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.projectData = {
            projectId: '@Model.ProjectId',
            projectName: '@Model.ProjectName',
            sendInvitationUrl: '@Url.Action("SendInvitation", "Projects")',
            getMembersUrl: '@Url.Action("GetMembers", "Projects")',
            removeMemberUrl: '@Url.Action("RemoveMember", "Projects")',
            updateTaskStatusUrl: '@Url.Action("UpdateStatus", "Task")',
            isProjectOwner: @(ViewBag.IsProjectOwner == true ? "true" : "false"),
            antiForgeryToken: '@Html.AntiForgeryToken()'
        };
        
        // Auto-refresh members list on page load
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(() => {
                console.log('Auto-refreshing team members on page load...');
                if (typeof refreshTeamMembers === 'function') {
                    refreshTeamMembers();
                }
            }, 500);
        });
    </script>
    <script src="~/js/webpages-js/project-dashboard.js" asp-append-version="true"></script>
}
